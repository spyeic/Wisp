# Wisp 配置：密钥仅保存在本地，勿提交真实 .env。

# Telegram：Bot Token 与用户白名单
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=

# AI 服务选择：openai / deepseek，修改后重启 Bot
AI_PROVIDER=openai

# OpenAI：选择 openai 时使用
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-2026-03-05
OPENAI_REASONING_EFFORT=high

# DeepSeek：选择 deepseek 时使用；图片解题使用 deepseek-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=high

# 回复偏好：语言与显示模式
DEFAULT_LANGUAGE=en
DEFAULT_MODE=watch

# 对话记忆：消息、文字、图片数量与保留时间
MAX_HISTORY_MESSAGES=10
MAX_HISTORY_CHARS=48000
MAX_HISTORY_IMAGES=1
HISTORY_TTL_SECONDS=1800

# 输入限制：图片大小、像素与文字长度
MAX_IMAGE_MB=10
MAX_IMAGE_PIXELS=25000000
MAX_TEXT_CHARS=6000

# 请求与发送限制：频率、超时、生成预算、消息间隔
REQUESTS_PER_MINUTE=6
REQUEST_TIMEOUT_SECONDS=240
MAX_OUTPUT_TOKENS=16000
MESSAGE_INTERVAL_MS=1100
